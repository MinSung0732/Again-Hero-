# Patch context contains intentional space prefixes before GDScript tabs.
docs/optimization/20261010/changes.patch -whitespace

# Godot writes these files with LF; keep Windows checkouts consistent.
*.import text eol=lf
*.uid text eol=lf
project.godot text eol=lf

# Shell scripts must keep LF or bash fails on Windows checkouts.
*.sh text eol=lf

# Windows launchers keep CRLF; PowerShell 5.1 needs the UTF-8 BOM kept as written.
*.cmd text eol=crlf
*.ps1 text eol=crlf
