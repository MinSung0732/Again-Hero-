extends SceneTree
const RESET := preload("res://src/systems/research_respec_store.gd")
const SCOPE := preload("res://src/systems/account_save_scope.gd")
const PROGRESS := preload("res://src/systems/stage_progress.gd")
const HERO := preload("res://src/systems/hero_mode_store.gd")
const DATA := preload("res://src/data/research_catalog.gd")
const MODE := preload("res://src/data/hero_mode_catalog.gd")
var checks := 0
func _initialize() -> void: run.call_deferred()
func check(ok: bool, message: String) -> void:
	checks += 1
	assert(ok,message)
func load_config(path: String) -> ConfigFile:
	var config := ConfigFile.new(); SCOPE.load_config(config,path); return config
func run() -> void:
	SCOPE.guest_directory = "user://respec_"+Crypto.new().generate_random_bytes(12).hex_encode()
	DirAccess.make_dir_recursive_absolute(SCOPE.guest_directory)
	SCOPE.select_guest()
	var progress := ConfigFile.new()
	progress.set_value("meta","research_points",5000)
	progress.set_value("meta","gold",987)
	progress.set_value("stamina","amount",117)
	progress.set_value("cleared","stage_1",true)
	progress.set_value("cleared","stage_3",true)
	var team := ConfigFile.new()
	team.set_value("loadout","selected_ids",["slime"])
	team.set_value("hero_loadout","selected_hero","ranged_rookie")
	team.set_value("hero_progress","stage_1_easy_wins",2)
	check(SCOPE.save_configs({"stage_progress.cfg":progress,"team_loadout.cfg":team}) == OK,"seed")
	var owner := RESET.owner()
	for index in 3:
		var cost := DATA.get_cost("monster_power",index)
		check(PROGRESS.try_purchase_research("monster_power",cost,70).success,"purchase and ledger")
	var estimate := RESET.preview("demon")
	check(int(estimate.refund) == DATA.get_cost("monster_power",0)+DATA.get_cost("monster_power",1)+DATA.get_cost("monster_power",2),"exact spent sum")
	var before := PROGRESS.get_research_points()
	check(not RESET.reset("demon","wrong owner").success and PROGRESS.get_research_points() == before,"stale account rejected")
	check(RESET.reset("demon",owner).success and PROGRESS.get_research_points() == 5000,"demon full refund")
	check(PROGRESS.get_research_level("monster_power") == 0,"demon levels cleared")
	check(RESET.reset("demon",owner).refunded == 0 and PROGRESS.get_research_points() == 5000,"repeated reset no duplicate refund")
	# Legacy per-character records plus migrated shared maximum are not double counted.
	team = load_config("user://team_loadout.cfg")
	team.set_value("hero_growth","stage_1_vitality",2)
	team.set_value("hero_growth","stage_2_vitality",1)
	team.set_value("hero_growth","shared_vitality",3)
	check(SCOPE.save_config(team,"user://team_loadout.cfg") == OK,"legacy seed")
	check(int(RESET.preview("hero").refund) == 1400,"legacy costs: 600 + 200 + shared delta 600")
	check(HERO.purchase_growth("ranged_rookie","power"),"hero purchase tracks legacy baseline once")
	check(int(RESET.preview("hero").refund) == 1600,"legacy baseline plus actual new spend")
	check(RESET.reset("hero",owner).refunded == 1600,"hero full refund")
	check(PROGRESS.get_research_points() == 6400,"hero wallet and levels saved together")
	check(HERO.growth_level("ranged_rookie","vitality") == 0 and HERO.growth_level("swift_hunter","vitality") == 0,"all legacy and shared levels reset")
	check(RESET.reset("hero",owner).refunded == 0 and PROGRESS.get_research_points() == 6400,"hero refund cannot repeat")
	check(HERO.purchase_growth("ranged_rookie","power") and HERO.growth_level("ranged_rookie","power") == 1,"reallocate after reset")
	progress = load_config("user://stage_progress.cfg")
	check(int(progress.get_value("meta","gold")) == 987 and int(progress.get_value("stamina","amount")) == 117,"unrelated wallets unchanged")
	team = load_config("user://team_loadout.cfg")
	check(team.get_value("loadout","selected_ids") == ["slime"] and int(team.get_value("hero_progress","stage_1_easy_wins")) == 2,"loadout and stage unlocks preserved")
	# A recorded cost is authoritative even if catalog prices later change.
	progress.set_value("research","monster_power",2)
	progress.set_value("research_spending","demon",777)
	SCOPE.save_config(progress,"user://stage_progress.cfg")
	check(RESET.reset("demon",owner).refunded == 777,"stored cost authoritative")
	# Legacy demon saves reconstruct all level costs only when no receipt exists.
	progress = load_config("user://stage_progress.cfg")
	progress.erase_section_key("research_spending","demon")
	progress.set_value("research","monster_vitality",2)
	SCOPE.save_config(progress,"user://stage_progress.cfg")
	check(int(RESET.preview("demon").refund) == DATA.get_cost("monster_vitality",0)+DATA.get_cost("monster_vitality",1),"legacy demon reconstruction")
	var original_dir := SCOPE.guest_directory
	SCOPE.guest_directory += "_corrupt"
	DirAccess.make_dir_recursive_absolute(SCOPE.guest_directory)
	SCOPE.select_guest()
	var file := FileAccess.open(SCOPE.guest_directory.path_join("stage_progress.cfg"),FileAccess.WRITE)
	file.store_string("[broken"); file.close()
	check(not RESET.reset("demon",RESET.owner()).success,"corrupt save never replaced")
	SCOPE.guest_directory = original_dir; SCOPE.select_guest()
	print("PASS research reset checks=",checks)
	quit()
