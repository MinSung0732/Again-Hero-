extends SceneTree
const RULES := preload("res://src/online/match_rules.gd")
const QUEUE := preload("res://src/online/match_queue.gd")
const ROOM := preload("res://src/online/battle_room.gd")
var checks := 0
func check(ok: bool,message: String) -> void:
	checks += 1
	if not ok: push_error(message); quit(1); assert(ok,message)
func _initialize() -> void: run.call_deferred()
func run() -> void:
	check(RULES.endpoint_valid("wss://example.invalid"),"WSS accepted")
	check(not RULES.endpoint_valid("ws://example.invalid"),"insecure public URL rejected")
	check(not RULES.point([NAN,0]),"nonfinite movement rejected")
	check(RULES.decode("[]".to_utf8_buffer()).is_empty(),"array packet rejected")
	check(RULES.decode("x".repeat(8193).to_utf8_buffer()).is_empty(),"oversize rejected")
	var queue = QUEUE.new()
	check(queue.enqueue(1,"a","hero"),"hero queue")
	check(not queue.enqueue(2,"a","demon"),"duplicate account")
	check(queue.pair().is_empty(),"same role cannot pair")
	check(queue.enqueue(2,"b","demon"),"demon queue")
	check(queue.pair() == [1,2],"FIFO opposite roles")
	var room = ROOM.new(); root.add_child(room); room.prepare()
	check(room.is_prepared and room.battle.online_match_mode,"actual Battle ready")
	check(room.battle.hero.player_controlled,"actual player-controlled hero")
	check(not room.battle._hero_chest_eligible("kills"),"online chest disabled")
	check(room.battle._grant_run_research_reward(false).is_empty(),"online reward disabled")
	check(room.battle.get_population_limit() == floori(room.battle.max_command) and room.battle.get_population_limit() == 100,"room population cap")
	var augments = load("res://src/data/demon_augment_catalog.gd")
	var maps = load("res://src/data/ranked_map_catalog.gd")
	var multiplier: float = float(maps.get_map(room.map_id).modifiers.get("command_regen_multiplier",1.0))
	check(is_equal_approx(room.battle.command_regen_per_second,4.0 * multiplier),"ranked base regen and map multiplier")
	room.battle._apply_demon_augment(augments.get_augment("command_regen"))
	check(is_equal_approx(room.battle.command_regen_per_second,4.0 * multiplier + 0.25),"regen augment applies after ranked base")
	room.battle._apply_demon_augment(augments.get_augment("command_capacity"))
	check(room.battle.get_population_limit() == 110 and room.battle.get_population_limit() == floori(room.battle.max_command),"capacity augment increases population")
	check(not room.apply("hero","move",[1,0]),"prestart input blocked")
	room.start()
	check(not room.apply("demon","move",[1,0]),"role spoof rejected")
	check(not room.apply("hero","move",[1,1]),"overspeed rejected")
	check(not room.apply("hero","choose",{"revision":[],"id":{}}),"malformed choice rejected")
	check(not room.apply("demon","summon",{"id":[],"point":[0,0]}),"malformed summon rejected")
	var initial: Vector2 = room.battle.hero.position
	check(room.apply("hero","move",[1,0]),"movement accepted")
	for i in 12: await physics_frame
	check(room.battle.hero.position.x > initial.x,"actual CharacterBody movement")
	room.step(1)
	check(room.battle.hero.player_move_input == Vector2.ZERO,"stale input clears")
	var spawn: Vector2 = room.battle.hero.position+Vector2(300,0)
	check(room.apply("demon","summon",{"id":"slime","point":[spawn.x,spawn.y]}),"actual routed summon")
	check(not room.apply("hero","summon",{"id":"slime","point":[spawn.x,spawn.y]}),"wrong summoning role rejected")
	check(not room.apply("demon","summon",{"id":"zeus","point":[spawn.x,spawn.y]}),"non-rule monster rejected")
	var target = room.battle.active_monsters.values()[0]
	var target_hp: int = target.current_hp
	for i in 150: room.step(1.0/60); await physics_frame
	check(not is_instance_valid(target) or target.current_hp < target_hp,"actual automatic weapon damages monster")
	room.battle.hero.gain_exp(400)
	check(not room.choice.is_empty(),"actual level-up choices")
	check(not room.apply("hero","choose",{"number":room.hero_holds[0].number-1,"id":room.choice[0].id}),"stale choice rejected")
	var selected_number: int = room.hero_holds[0].number
	check(room.apply("hero","choose",{"number":selected_number,"id":room.choice[0].id}),"actual augment selection")
	check(not room.apply("hero","choose",{"number":selected_number,"id":"invalid"}),"invalid/replayed choice rejected")
	var snapshot: Dictionary = room.snapshot()
	check(snapshot.hero[3] > 0 and snapshot.bounds[0] > 0,"actual state serializes")
	check(not JSON.stringify(snapshot).is_empty(),"JSON safe snapshot")
	check(room.ids.size() <= room.battle.get_population_limit(),"bounded identity map")
	var other = ROOM.new(); root.add_child(other); other.prepare(); other.start()
	check(room.world.world_2d != other.world.world_2d,"physics isolation")
	check(room.battle.hero != other.battle.hero,"hero isolation")
	var other_spawn: Vector2 = other.battle.hero.position+Vector2(300,0)
	check(other.apply("demon","summon",{"id":"orc","point":[other_spawn.x,other_spawn.y]}),"second room actual monster")
	var other_actor = other.battle.active_monsters.values()[0]
	room.battle.set_external_pause(true)
	check(other_actor.is_physics_processing(),"pause cannot affect another room")
	check(other_actor.hero == other.battle.hero,"monster keeps own room hero")
	for actor in room.battle.active_monsters.values(): actor.remove_from_group("monsters")
	room.battle.active_monsters.clear()
	check(room.battle.hero._find_nearest_monster() == null,"empty room cannot target another room")
	room.battle._on_run_time_up()
	check(room.finished and room.winner == "hero","actual survival finish")
	room.finish("demon","duplicate")
	check(room.winner == "hero","result idempotency")
	other.battle._on_hero_died()
	check(other.finished and other.winner == "demon","actual hero death finish")
	check(not room.apply("hero","move",[0,1]),"postresult input blocked")
	room.queue_free(); other.queue_free(); await process_frame
	await create_timer(0.15).timeout # Let the audio server drain stopped playbacks.
	print("ONLINE_REAL_BATTLE_PASS checks=",checks); quit()
