shader_parameter/bottom_fade_start = 0.84
shader_parameter/bottom_fade_strength = 0.52

[sub_resource type="Shader" id="Shader_floor_fog"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tfloat y = smoothstep(0.0, 0.82, UV.y);\n\tfloat center = 1.0 - smoothstep(0.0, 0.58, abs(UV.x - 0.5));\n\tvec3 fog_color = mix(vec3(0.025, 0.022, 0.055), vec3(0.11, 0.045, 0.15), center * 0.42);\n\tCOLOR = vec4(fog_color, y * 0.48);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_floor_fog"]
shader = SubResource("Shader_floor_fog")

