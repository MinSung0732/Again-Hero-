[sub_resource type="Shader" id="Shader_atmosphere"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec2 centered = UV - vec2(0.5);\n\tfloat radial = length(centered * vec2(0.92, 1.12));\n\tfloat vignette = smoothstep(0.30, 0.72, radial);\n\tfloat top_shadow = smoothstep(0.0, 0.28, 1.0 - UV.y);\n\tvec3 tint = mix(vec3(0.055, 0.035, 0.10), vec3(0.01, 0.012, 0.028), vignette);\n\tfloat alpha = 0.12 + vignette * 0.34 + top_shadow * 0.05;\n\tCOLOR = vec4(tint, alpha);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_atmosphere"]
shader = SubResource("Shader_atmosphere")

[sub_resource type="Shader" id="Shader_portrait_blend"]
code = "shader_type canvas_item;\nuniform float fade_left : hint_range(0.0, 0.4) = 0.0;\nuniform float fade_right : hint_range(0.0, 0.4) = 0.0;\nuniform float side_fade_strength : hint_range(0.0, 1.0) = 1.0;\nuniform float bottom_fade_start : hint_range(0.5, 0.95) = 0.72;\nuniform float bottom_fade_strength : hint_range(0.0, 1.0) = 0.88;\n\nvoid fragment() {\n\tvec4 tex = texture(TEXTURE, UV) * COLOR;\n\tfloat bottom_fade = 1.0 - smoothstep(bottom_fade_start, 1.0, UV.y);\n\tfloat lower_weight = smoothstep(0.34, 0.72, UV.y);\n\tfloat left_mask = 1.0;\n\tfloat right_mask = 1.0;\n\tif (fade_left > 0.001) {\n\t\tleft_mask = smoothstep(0.0, fade_left, UV.x);\n\t}\n\tif (fade_right > 0.001) {\n\t\tright_mask = 1.0 - smoothstep(1.0 - fade_right, 1.0, UV.x);\n\t}\n\tfloat side_mask = min(left_mask, right_mask);\n\tfloat softened_side = mix(1.0, side_mask, lower_weight * side_fade_strength);\n\ttex.a *= mix(1.0, bottom_fade, bottom_fade_strength);\n\ttex.a *= softened_side;\n\tCOLOR = tex;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_demon_portrait"]
shader = SubResource("Shader_portrait_blend")
shader_parameter/fade_left = 0.0
shader_parameter/fade_right = 0.18
shader_parameter/side_fade_strength = 0.92
shader_parameter/bottom_fade_start = 0.84
shader_parameter/bottom_fade_strength = 0.52

[sub_resource type="ShaderMaterial" id="ShaderMaterial_hero_portrait"]
