[sub_resource type="Shader" id="Shader_live_art"]
code = "shader_type canvas_item;\n\nuniform float reveal_progress : hint_range(0.0, 1.0) = 0.0;\nuniform float glow_pulse : hint_range(0.0, 1.0) = 0.0;\n\nfloat luma(vec3 color) {\n\treturn dot(color, vec3(0.299, 0.587, 0.114));\n}\n\nvoid fragment() {\n\tvec4 base = texture(TEXTURE, UV) * COLOR;\n\tfloat diagonal = UV.x * 0.72 + (1.0 - UV.y) * 0.28;\n\tfloat reveal = smoothstep(diagonal, diagonal + 0.12, reveal_progress * 1.12);\n\tfloat brightness = smoothstep(0.58, 0.96, luma(base.rgb));\n\tvec3 warm_glow = vec3(1.0, 0.72, 0.24) * brightness * glow_pulse * 0.16;\n\tbase.rgb += warm_glow;\n\tbase.a *= reveal;\n\tCOLOR = base;\n}\n"

