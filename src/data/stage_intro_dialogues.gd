extends RefCounted
class_name StageIntroDialogues


static func get_dialogue(stage_id: String) -> Dictionary:
	match stage_id:
		"stage_1":
			return _stage_1()
		"stage_2":
			return _stage_2()
		"stage_3":
			return _stage_3()
		"stage_4":
			return _stage_4()
		_:
			return {}


