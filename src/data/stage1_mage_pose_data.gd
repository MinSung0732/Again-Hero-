extends RefCounted
class_name Stage1MagePoseData

const PALETTE := [
	Color8(214,197,188), Color8(168,146,141), Color8(148,116,96),
	Color8(117,108,122), Color8(117,88,76), Color8(95,82,95),
	Color8(74,78,125), Color8(73,63,82), Color8(66,52,57),
	Color8(50,50,79), Color8(42,36,45), Color8(29,24,30),
	Color8(12,11,14), Color8(4,2,5), Color8(0,0,2)
]

const FRAMES := {
	"idle_0": "",
	"idle_1": "",
	"walk": "",
	"run": "",
	"attack": "",
	"hit": "",
	"death_0": "",
	"death_1": ""
}

static func build_texture(frame_id: String) -> Texture2D:
	var encoded: String = String(FRAMES.get(frame_id, ""))
	if encoded.is_empty():
		return null

	var runs: PackedByteArray = Marshalls.base64_to_raw(encoded)
	if runs.is_empty():
		return null

	var image := Image.create(32, 32, false, Image.FORMAT_RGBA8)
	image.fill(Color(0, 0, 0, 0))

	var pixel_index := 0
	var cursor := 0
	while cursor + 1 < runs.size() and pixel_index < 1024:
		var count: int = int(runs[cursor])
		var palette_index: int = int(runs[cursor + 1])
		cursor += 2

		for _i in range(count):
			if pixel_index >= 1024:
				break

			var x := pixel_index % 32
			var y := pixel_index / 32
			if palette_index >= 0 and palette_index < PALETTE.size():
				image.set_pixel(x, y, PALETTE[palette_index])
			pixel_index += 1

	return ImageTexture.create_from_image(image)
